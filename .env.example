# MongoDB Atlas or a local replica set (transactions are required).
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=divhacks2026

# Generate a random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud OAuth 2.0 Web application credentials.
# Leave both blank to run email/phone + password auth without Google locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public browser key: restrict to your site referrers and Maps JavaScript API.
GOOGLE_MAPS_API_KEY=

# Only trust headers overwritten by your ingress; the origin must not be public.
AUTH_IP_ADDRESS_HEADERS=x-forwarded-for
# Comma-separated IPs/CIDRs of actual trusted proxy hops for multi-hop XFF.
AUTH_TRUSTED_PROXIES=

# Photon (Spectrum): copy this file to .env.local and fill in the values from
# https://app.photon.codes → your project → Settings.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Relay (npm run relay): the two people to pass texts between.
RELAY_A_PHONE=
RELAY_A_NAME=
RELAY_B_PHONE=
RELAY_B_NAME=
