# MongoDB Atlas or a local replica set (transactions are required).
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=divhacks2026

# Generate a random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud OAuth 2.0 Web application credentials.
# Leave both blank to run email/phone + password auth without Google locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
