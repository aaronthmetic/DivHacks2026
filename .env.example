# Photon (Spectrum): copy this file to .env.local and fill in the values from
# https://app.photon.codes → your project → Settings.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Relay (npm run relay): the two people to pass texts between.
RELAY_A_PHONE=
RELAY_A_NAME=
RELAY_B_PHONE=
RELAY_B_NAME=

# Google Maps JavaScript API key. Browsers see it, so restrict it to your
# domains in Google Cloud.
GOOGLE_MAPS_API_KEY=
